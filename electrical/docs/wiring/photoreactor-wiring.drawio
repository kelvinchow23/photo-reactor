<mxfile host="app.diagrams.net"><diagram name="Reactor wiring"><mxGraphModel page="1" pageWidth="1500" pageHeight="1060"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="PHOTOREACTOR  /  WIRING GUIDE&lt;br&gt;Rev A hardware • SDL4-0001 controller + SDL4-0002 LED boards • 15 Oct 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=25;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1440" height="95" /></mxCell><mxCell id="3" value="COMPUTER&lt;br&gt;USB data → Pico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9efff;strokeColor=#d1d9e6;fontSize=19;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="140" width="270" height="90" /></mxCell><mxCell id="4" value="12 V DC ADAPTER&lt;br&gt;→ controller power input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9efff;strokeColor=#d1d9e6;fontSize=19;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="255" width="270" height="90" /></mxCell><mxCell id="5" value="CONTROLLER&lt;br&gt;SDL4-0001&lt;br&gt;&lt;br&gt;REACTOR 1 → shown here&lt;br&gt;REACTOR 2–4: repeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9efff;strokeColor=#d1d9e6;fontSize=20;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="390" width="300" height="230" /></mxCell><mxCell id="6" style="endArrow=none;strokeColor=#506179;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="165" y="230" /><mxPoint as="targetPoint" x="315" y="410" /><Array as="points"><mxPoint x="165" y="242" /><mxPoint x="315" y="242" /></Array></mxGeometry></mxCell><mxCell id="7" style="endArrow=none;strokeColor=#506179;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="165" y="345" /><mxPoint as="targetPoint" x="165" y="390" /><Array as="points" /></mxGeometry></mxCell><mxCell id="8" value="FIRST LED BOARD&lt;br&gt;SDL4-0002 • LED A&lt;br&gt;&lt;br&gt;J1 IN: 10-pin&lt;br&gt;J2 OUT: 6-pin JST PH&lt;br&gt;J3 FAN: 4-pin JST PH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f4ee;strokeColor=#d1d9e6;fontSize=20;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="390" width="330" height="230" /></mxCell><mxCell id="9" value="SECOND LED BOARD&lt;br&gt;SDL4-0002 • LED B&lt;br&gt;&lt;br&gt;J1 IN: 10-pin&lt;br&gt;J2 OUT: LEAVE EMPTY&lt;br&gt;J3 FAN: 4-pin JST PH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f4ee;strokeColor=#d1d9e6;fontSize=20;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="390" width="330" height="230" /></mxCell><mxCell id="10" style="endArrow=none;strokeColor=#506179;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="330" y="470" /><mxPoint as="targetPoint" x="420" y="470" /><Array as="points" /></mxGeometry></mxCell><mxCell id="11" value="CABLE A • CONTROLLER → FIRST J1&lt;br&gt;10-pin keyed IDC, female ↔ female&lt;br&gt;Straight-through: pin n → pin n" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#d1d9e6;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="335" y="260" width="410" height="95" /></mxCell><mxCell id="12" style="endArrow=none;strokeColor=#b77618;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="750" y="470" /><mxPoint as="targetPoint" x="900" y="470" /><Array as="points" /></mxGeometry></mxCell><mxCell id="13" value="CABLE B • FIRST J2 → SECOND J1&lt;br&gt;Custom 6-pin JST PH → 10-pin IDC&lt;br&gt;Exact mapping below; not straight-through" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d9;strokeColor=#d1d9e6;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="260" width="460" height="95" /></mxCell><mxCell id="14" value="STIRRING FAN&lt;br&gt;4 wires • 5 V / GND / tach / PWM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="140" width="330" height="90" /></mxCell><mxCell id="15" value="COOLING FAN&lt;br&gt;4 wires • 5 V / GND / tach / PWM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="140" width="330" height="90" /></mxCell><mxCell id="16" style="endArrow=none;strokeColor=#506179;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="710" y="580" /><mxPoint as="targetPoint" x="735" y="230" /><Array as="points"><mxPoint x="770" y="580" /><mxPoint x="770" y="245" /><mxPoint x="735" y="245" /></Array></mxGeometry></mxCell><mxCell id="17" style="endArrow=none;strokeColor=#506179;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1200" y="580" /><mxPoint as="targetPoint" x="1230" y="185" /><Array as="points"><mxPoint x="1260" y="580" /><mxPoint x="1260" y="185" /></Array></mxGeometry></mxCell><mxCell id="18" value="FAN LEADS&lt;br&gt;J3 → fan&lt;br&gt;&lt;br&gt;PHR-4 plug&lt;br&gt;2.0 mm pitch&lt;br&gt;Terminate existing&lt;br&gt;fan wires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="390" width="190" height="230" /></mxCell><mxCell id="19" value="CABLE A • 10-PIN PINOUT&lt;br&gt;1  LED A +          2  LED A −&lt;br&gt;3  LED B +          4  LED B −&lt;br&gt;5  Stir tach          6  Cool tach&lt;br&gt;7  Fan +5 V         8  Ground&lt;br&gt;9  Stir PWM       10  Cool PWM&lt;br&gt;&lt;br&gt;All ten pins connect straight-through.&lt;br&gt;LED − is NOT ground." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=19;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="660" width="440" height="335" /></mxCell><mxCell id="20" value="CABLE B • CUSTOM HARNESS&lt;br&gt;First J2 OUT          Second J1 IN&lt;br&gt;1  LED B +       →    1&lt;br&gt;2  LED B −       →    2&lt;br&gt;3  Fan +5 V      →    7&lt;br&gt;4  Ground        →    8&lt;br&gt;5  Cool tach     →    5&lt;br&gt;6  Cool PWM    →    9&lt;br&gt;Leave second J1 pins 3, 4, 6, 10 unwired." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d9;strokeColor=#d1d9e6;fontSize=19;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="660" width="520" height="335" /></mxCell><mxCell id="21" value="EACH FAN • J3 PINOUT&lt;br&gt;1  Ground&lt;br&gt;2  +5 V&lt;br&gt;3  Tach / RPM feedback&lt;br&gt;4  PWM speed control&lt;br&gt;&lt;br&gt;FOUR-REACTOR TOTAL&lt;br&gt;1 controller • 8 LED boards • 8 fans&lt;br&gt;4 × Cable A • 4 × custom Cable B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=19;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="660" width="440" height="335" /></mxCell><mxCell id="22" value="Logical wiring diagram—not connector face views. Use numbered contacts; verify continuity before powering. Set controller JP_FANV to 2–3 (5 V)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e6;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1010" width="1440" height="40" /></mxCell></root></mxGraphModel></diagram></mxfile>